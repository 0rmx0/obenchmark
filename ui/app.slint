import "../ui/fonts/HelpMe.ttf";
// Police de marque R_M_X. Nom de famille embarqué dans le fichier : "Help Me"
// (avec un espace) — c'est ce nom exact qu'il faut utiliser dans font-family ci-dessous.

import { ScrollView } from "std-widgets.slint";

export struct ScoreRow {
    name: string,
    value: string,
}

export struct InfoLine {
    text: string,
}

// ---------------------------------------------------------------------
// Design tokens — Charte graphique R_M_X v2.0 (Dark Streetwear / Horror Punk / Cyberpunk)
// ---------------------------------------------------------------------
global Palette {
    // Palette v2
    out property <color> bg-void: #050505;         // Noir Absolu — fond principal
    out property <color> bg-panel: #111111;         // Noir Charbon — fond panneaux
    out property <color> bg-panel-hover: #1c1c1c;   // variation entre Noir Charbon et Gris Anthracite
    out property <color> border-idle: #232323;      // Gris Anthracite — bordures fines
    out property <color> border-strong: #3a3a3a;
    out property <color> text-dim: #6e6b64;         // dérivé grisé du Blanc Cassé
    out property <color> text-mid: #b3afa4;         // dérivé clair du Blanc Cassé
    out property <color> text-bright: #f5f2ea;      // Blanc Cassé — texte principal

    out property <color> cyan: #7af9ff;             // Cyan Glacial — accent / glow au survol
    out property <color> cyan-dim: #3f8a8f;
    out property <color> rose: #ff7a92;             // Rose Néon — accent secondaire
    out property <color> rose-dim: #8a4451;
    out property <color> rouge: #b8323b;            // Rouge Enfer — alerte / danger
    out property <color> rouge-dim: #5e1a1f;

    // Formes : direction "brutalist composition" / gravure -> coins presque droits
    out property <length> radius: 2px;
}

// ---------------------------------------------------------------------
// Primitives
// ---------------------------------------------------------------------
component HairlineDivider inherits Rectangle {
    height: 1px;
    background: Palette.border-idle;
}

component StatusDot inherits Rectangle {
    in property <color> tone: Palette.text-dim;
    in property <bool> pulsing: false;

    width: 7px;
    height: 7px;
    background: root.tone;
    border-width: 1px;
    border-color: root.tone.darker(0.2);

    property <bool> pulse-phase: false;
    drop-shadow-color: root.pulsing ? Palette.cyan.with-alpha(root.pulse-phase ? 0.75 : 0.15) : transparent;
    drop-shadow-blur: root.pulsing ? (root.pulse-phase ? 9px : 3px) : 0px;
    animate drop-shadow-color, drop-shadow-blur { duration: 900ms; easing: ease-in-out; }

    Timer {
        interval: 900ms;
        running: root.pulsing;
        triggered => { root.pulse-phase = !root.pulse-phase; }
    }
}

component NoirButton inherits Rectangle {
    in property <string> text;
    in property <color> tone: Palette.cyan;
    callback clicked <=> touch.clicked;

    height: 42px;
    border-radius: Palette.radius;
    background: touch.pressed ? Palette.bg-void : (touch.has-hover ? Palette.bg-panel-hover : Palette.bg-panel);
    border-width: 1px;
    border-color: touch.has-hover ? root.tone : Palette.border-idle;
    // Spec charte v2 (UI) : "Glow cyan au survol" — glow toujours en Cyan Glacial,
    // indépendamment de la couleur sémantique du bouton (ex: bouton danger en Rouge Enfer).
    drop-shadow-color: touch.has-hover ? Palette.cyan.with-alpha(0.35) : transparent;
    drop-shadow-blur: touch.has-hover ? 12px : 0px;

    animate background, border-color, drop-shadow-color { duration: 200ms; easing: ease; }

    HorizontalLayout {
        alignment: center;
        Text {
            text: root.text;
            color: touch.has-hover ? root.tone : Palette.text-bright;
            font-family: "Help Me";
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 2px;
            vertical-alignment: center;
            animate color { duration: 200ms; }
        }
    }

    touch := TouchArea { }
}

component ProgressRail inherits Rectangle {
    in property <float> progress: 0.0;
    height: 5px;
    border-radius: Palette.radius;
    background: Palette.bg-panel;
    border-width: 1px;
    border-color: Palette.border-idle;
    clip: true;

    Rectangle {
        x: 1px;
        y: 1px;
        height: parent.height - 2px;
        width: max(0px, (parent.width - 2px) * root.progress);
        background: Palette.cyan;
        drop-shadow-color: Palette.cyan.with-alpha(0.5);
        drop-shadow-blur: 6px;
        animate width { duration: 200ms; easing: ease; }
    }
}

component Readout inherits Rectangle {
    in property <string> text;
    in property <color> tone: Palette.cyan;

    background: Palette.bg-panel;
    border-width: 1px;
    border-color: Palette.border-idle;
    border-radius: Palette.radius;
    horizontal-stretch: 1;
    clip: true;

    HorizontalLayout {
        Rectangle {
            width: 3px;
            background: root.tone;
        }
        VerticalLayout {
            padding: 14px;
            alignment: center;
            Text {
                text: root.text;
                color: Palette.text-bright;
                font-family: "Help Me";
                font-size: 14px;
                font-weight: 600;
                wrap: word-wrap;
            }
        }
    }
}

component SectionLabel inherits Text {
    font-family: "Help Me";
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    color: Palette.text-mid;
}

// ---------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------
export component MainWindow inherits Window {
    title: "OBENCHMARK";
    preferred-width: 1040px;
    preferred-height: 760px;
    background: Palette.bg-void;
    default-font-family: "Help Me";

    in-out property <string> status: "idle";
    in-out property <string> current-test: "";
    in-out property <float> progress: 0.0;
    in-out property <string> error-message: "";

    in-out property <string> final-score: "";
    in-out property <string> cpu-score: "";
    in-out property <string> mem-score: "";
    in-out property <string> disk-score: "";

    in-out property <[ScoreRow]> scores: [];
    in-out property <[InfoLine]> system-info: [];

    callback start-clicked();
    callback export-clicked();
    callback restart-clicked();

    property <color> status-tone:
        root.status == "error" ? Palette.rouge :
        root.status == "running" ? Palette.cyan :
        root.status == "showing" ? Palette.cyan : Palette.text-dim;

    // Base fill
    Rectangle { background: Palette.bg-void; }

    // Grain texture overlay — renforcé pour la direction "gravure et hachures" de la v2
    Image {
        source: @image-url("../grain.png");
        width: 100%;
        height: 100%;
        image-fit: cover;
        opacity: 0.08;
    }

    // Faint watermark logo
    Image {
        source: @image-url("../icon.png");
        opacity: 0.035;
        image-fit: contain;
        width: min(parent.width * 0.5, 380px);
        height: min(parent.height * 0.5, 380px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    VerticalLayout {
        padding: 28px;
        spacing: 18px;

        // ---- Header ----
        HorizontalLayout {
            spacing: 14px;

            VerticalLayout {
                alignment: center;
                Text {
                    text: "OBENCHMARK";
                    font-family: "Help Me";
                    font-size: 20px;
                    font-weight: 700;
                    letter-spacing: 4px;
                    color: Palette.text-bright;
                }
                Text {
                    text: "SYSTEM PERFORMANCE ANALYSIS";
                    font-family: "Help Me";
                    font-size: 10px;
                    letter-spacing: 2px;
                    color: Palette.text-mid;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                StatusDot { tone: root.status-tone; pulsing: root.status == "running"; }
                Text {
                    text: root.status;
                    font-family: "Help Me";
                    font-size: 11px;
                    letter-spacing: 2px;
                    color: root.status-tone;
                    vertical-alignment: center;
                }
            }
        }

        HairlineDivider { }

        // ---- Body ----
        Rectangle {
            vertical-stretch: 1;

            // IDLE
            if root.status == "idle": VerticalLayout {
                alignment: center;
                spacing: 22px;

                Rectangle {
                    height: 1px;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text {
                        text: "READY";
                        horizontal-alignment: center;
                        font-family: "Help Me";
                        font-size: 13px;
                        letter-spacing: 3px;
                        color: Palette.text-mid;
                    }
                    Text {
                        text: "Le systeme est pret pour l'analyse.";
                        horizontal-alignment: center;
                        font-family: "Help Me";
                        font-size: 13px;
                        color: Palette.text-mid;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    NoirButton {
                        width: 260px;
                        text: "INITIER LE BENCHMARK";
                        tone: Palette.cyan;
                        clicked => { root.start-clicked(); }
                    }
                }
            }

            // RUNNING
            if root.status == "running": VerticalLayout {
                alignment: center;
                spacing: 18px;

                SectionLabel {
                    text: "ANALYSE EN COURS";
                    horizontal-alignment: center;
                }

                Text {
                    text: root.current-test;
                    horizontal-alignment: center;
                    font-family: "Help Me";
                    font-size: 22px;
                    font-weight: 600;
                    color: Palette.text-bright;
                }

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(parent.width, 480px);
                        ProgressRail { progress: root.progress; }
                    }
                }

                Text {
                    text: "\{Math.round(root.progress * 100)}%";
                    horizontal-alignment: center;
                    font-family: "Help Me";
                    font-size: 12px;
                    color: Palette.cyan;
                }
            }

            // SHOWING
            if root.status == "showing": VerticalLayout {
                spacing: 16px;

                HorizontalLayout {
                    spacing: 10px;
                    Readout { text: root.final-score; tone: Palette.cyan; }
                    Readout { text: root.cpu-score; tone: Palette.rose-dim; }
                    Readout { text: root.mem-score; tone: Palette.rose-dim; }
                    Readout { text: root.disk-score; tone: Palette.rose-dim; }
                }

                HairlineDivider { }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 0px;

                        SectionLabel {
                            text: "RESULTATS DETAILLES";
                        }

                        Rectangle { height: 8px; }

                        for score[i] in root.scores: Rectangle {
                            height: 34px;
                            background: Palette.bg-void;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: score.name;
                                    color: Palette.text-mid;
                                    font-family: "Help Me";
                                    font-size: 13px;
                                    horizontal-stretch: 2;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: score.value;
                                    color: Palette.cyan;
                                    font-family: "Help Me";
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            HairlineDivider {
                                y: parent.height - 1px;
                            }
                        }

                        Rectangle { height: 16px; }

                        SectionLabel {
                            text: "INFORMATIONS SYSTEME";
                        }

                        Rectangle { height: 8px; }

                        Rectangle {
                            background: Palette.bg-panel;
                            border-width: 1px;
                            border-color: Palette.border-idle;
                            border-radius: Palette.radius;
                            clip: true;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;

                                for line in root.system-info: Text {
                                    text: "> " + line.text;
                                    color: Palette.text-mid;
                                    font-family: "Help Me";
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle { height: 8px; }
                    }
                }

                HairlineDivider { }

                HorizontalLayout {
                    spacing: 10px;
                    NoirButton {
                        text: "EXPORTER JSON";
                        tone: Palette.cyan;
                        clicked => { root.export-clicked(); }
                    }
                    NoirButton {
                        text: "NOUVELLE ANALYSE";
                        tone: Palette.rouge;
                        clicked => { root.restart-clicked(); }
                    }
                }
            }

            // ERROR
            if root.status == "error": VerticalLayout {
                alignment: center;
                spacing: 14px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(parent.width * 0.8, 520px);
                        background: Palette.bg-panel;
                        border-width: 1px;
                        border-color: Palette.rouge-dim;
                        border-radius: Palette.radius;
                        clip: true;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 8px;
                                StatusDot { tone: Palette.rouge; }
                                Text {
                                    text: "ERREUR SYSTEME";
                                    font-family: "Help Me";
                                    font-size: 12px;
                                    letter-spacing: 3px;
                                    color: Palette.rouge;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: root.error-message;
                                color: Palette.text-mid;
                                font-family: "Help Me";
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
