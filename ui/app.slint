import "../ui/fonts/HelpMe.ttf";
// Police de marque R_M_X. Nom de famille embarqué dans le fichier : "Help Me"
// (avec un espace) — c'est ce nom exact qu'il faut utiliser ci-dessous.

export struct ScoreRow {
    name: string,
    value: string,
}

export struct InfoLine {
    text: string,
}

// ---------------------------------------------------------------------
// Charte Terminal R_M_X v2 : vert CRT sur noir-vert, une seule teinte,
// un seul halo, un seul mouvement (le curseur █ qui clignote).
// ---------------------------------------------------------------------
global Palette {
    out property <color> bg: #0A0F0A;   // noir-vert — fond unique
    out property <color> crt: #33FF66;   // vert CRT — seule teinte
    out property <color> halo: #33FF66.with-alpha(0.55); // seul halo admis
    out property <color> line: #33FF66.with-alpha(0.35); // séparateurs / bordures
    out property <color> dim: #33FF66.with-alpha(0.55);  // texte secondaire
    out property <color> faint: #33FF66.with-alpha(0.20);
}

// ---------------------------------------------------------------------
// Primitives
// ---------------------------------------------------------------------
component Hairline inherits Rectangle {
    height: 1px;
    background: Palette.line;
}

component CrtCursor inherits Text {
    text: "█";
    color: Palette.crt;
    property <bool> phase: true;
    visible: root.phase;
    Timer {
        interval: 500ms;
        running: true;
        triggered => { root.phase = !root.phase; }
    }
}

component StatusLED inherits Rectangle {
    in property <bool> active: false;
    width: 8px;
    height: 8px;
    background: Palette.crt;
    drop-shadow-color: root.active ? Palette.halo : transparent;
    drop-shadow-blur: root.active ? 6px : 0px;
}

component HaloText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;
    in property <length> letter-spacing: 0px;
    in property <color> tone: Palette.crt;
    in property <bool> center: false;

    width: 100%;
    height: main-text.preferred-height;

    Text {
        x: -1px;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
        color: root.tone.with-alpha(0.25);
        width: 100%;
        horizontal-alignment: root.center ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
    }
    Text {
        x: 1px;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
        color: root.tone.with-alpha(0.25);
        width: 100%;
        horizontal-alignment: root.center ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
    }
    Text {
        y: -1px;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
        color: root.tone.with-alpha(0.25);
        width: 100%;
        horizontal-alignment: root.center ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
    }
    Text {
        y: 1px;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
        color: root.tone.with-alpha(0.25);
        width: 100%;
        horizontal-alignment: root.center ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
    }
    main-text := Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
        color: root.tone;
        width: 100%;
        horizontal-alignment: root.center ? TextHorizontalAlignment.center : TextHorizontalAlignment.left;
    }
}

component CrtButton inherits Rectangle {
    in property <string> text;
    callback clicked <=> touch.clicked;

    height: 42px;
    horizontal-stretch: 1;
    border-width: 1px;
    border-color: touch.has-hover ? Palette.crt : Palette.line;
    background: touch.has-hover ? Palette.crt : Palette.bg;
    drop-shadow-color: touch.has-hover ? Palette.halo : transparent;
    drop-shadow-blur: touch.has-hover ? 6px : 0px;

    Text {
        text: "[ " + root.text + " ]";
        color: touch.has-hover ? Palette.bg : Palette.crt;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea { mouse-cursor: pointer; }
}

component SectionLabel inherits Text {
    in property <string> label;
    text: "── " + root.label;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    color: Palette.dim;
}

component Readout inherits Rectangle {
    in property <string> text;

    height: 48px;
    horizontal-stretch: 1;
    background: Palette.bg;
    border-width: 1px;
    border-color: Palette.line;

    Text {
        text: root.text;
        color: Palette.crt;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

component CrtScrollView inherits Rectangle {
    in property <length> bar-w: 5px;
    background: Palette.bg;

    flick := Flickable {
        width: parent.width - root.bar-w;
        height: parent.height;
        @children
    }

    Rectangle {
        x: parent.width - root.bar-w;
        width: root.bar-w;
        height: parent.height;
        background: Palette.faint;
        visible: flick.content-height > flick.height;
    }

    Rectangle {
        width: root.bar-w;
        x: parent.width - self.width;
        height: max(root.bar-w, root.height * root.height / max(1px, flick.content-height));
        y: -flick.content-y * (root.height - self.height) / max(1px, flick.content-height - root.height);
        background: Palette.crt.with-alpha(0.7);
        visible: flick.content-height > flick.height;
    }
}

// ---------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------
export component MainWindow inherits Window {
    title: "OBENCHMARK";
    preferred-width: 1040px;
    preferred-height: 760px;
    background: Palette.bg;
    default-font-family: "Help Me";

    in-out property <string> status: "idle";
    in-out property <string> current-test: "";
    in-out property <float> progress: 0.0;
    in-out property <string> error-message: "";

    in-out property <string> final-score: "";
    in-out property <string> cpu-score: "";
    in-out property <string> mem-score: "";
    in-out property <string> disk-score: "";

    in-out property <[ScoreRow]> scores: [];
    in-out property <[InfoLine]> system-info: [];

    callback start-clicked();
    callback export-clicked();
    callback restart-clicked();

    property <string> status-label:
        root.status == "error" ? "ERREUR" :
        root.status == "running" ? "EN COURS" :
        root.status == "showing" ? "TERMINÉ" : "EN ATTENTE";

    // Cadre plein écran
    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        border-width: 1px;
        border-color: Palette.line;
    }

    VerticalLayout {
        padding: 28px;
        padding-left: 36px;
        padding-right: 36px;
        spacing: 16px;

        // ---- Header ----
        HorizontalLayout {
            spacing: 14px;

            VerticalLayout {
                alignment: center;
                spacing: 4px;
                HaloText {
                    text: "OBENCHMARK";
                    font-size: 20px;
                    font-weight: 700;
                    letter-spacing: 4px;
                }
                Text {
                    text: "ANALYSE DES PERFORMANCES SYSTÈME";
                    font-size: 10px;
                    letter-spacing: 2px;
                    color: Palette.dim;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                StatusLED { active: root.status == "running" || root.status == "error"; }
                Text {
                    text: root.status-label;
                    font-size: 11px;
                    letter-spacing: 2px;
                    color: Palette.crt;
                    vertical-alignment: center;
                }
                CrtCursor { font-size: 12px; }
            }
        }

        Hairline { }

        // ---- Body ----
        Rectangle {
            vertical-stretch: 1;

            // IDLE
            if root.status == "idle": VerticalLayout {
                alignment: center;
                spacing: 20px;

                Text {
                    text: "PRÊT";
                    horizontal-alignment: center;
                    font-size: 14px;
                    font-weight: 700;
                    letter-spacing: 4px;
                    color: Palette.crt;
                }
                Text {
                    text: "Le système est prêt pour l'analyse.";
                    horizontal-alignment: center;
                    font-size: 13px;
                    color: Palette.dim;
                }
                Text {
                    text: "T0JNSzo6Uk1YOjpDUlQ6OjBBMEYwQTo6MzNGRjY2OjpURVJNSU5BTC1WMg==";
                    horizontal-alignment: center;
                    font-size: 9px;
                    color: Palette.faint;
                }

                HorizontalLayout {
                    alignment: center;
                    CrtButton {
                        width: 300px;
                        text: "INITIER LE BENCHMARK";
                        clicked => { root.start-clicked(); }
                    }
                }
            }

            // RUNNING
            if root.status == "running": VerticalLayout {
                alignment: center;
                spacing: 18px;

                SectionLabel {
                    label: "ANALYSE EN COURS";
                    horizontal-alignment: center;
                }

                HaloText {
                    text: root.current-test;
                    font-size: 22px;
                    font-weight: 700;
                    center: true;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 3px;
                    for i in 24: Rectangle {
                        width: 12px;
                        height: 14px;
                        border-width: 1px;
                        border-color: Palette.line;
                        background: (i + 1) / 24.0 <= root.progress ? Palette.crt : Palette.bg;
                        drop-shadow-color: (i + 1) / 24.0 <= root.progress ? Palette.halo : transparent;
                        drop-shadow-blur: (i + 1) / 24.0 <= root.progress ? 6px : 0px;
                    }
                }

                Text {
                    text: "\{Math.round(root.progress * 100)}%";
                    horizontal-alignment: center;
                    font-size: 12px;
                    color: Palette.crt;
                }
            }

            // SHOWING
            if root.status == "showing": VerticalLayout {
                spacing: 14px;

                HorizontalLayout {
                    spacing: 10px;
                    Readout { text: root.final-score; }
                    Readout { text: root.cpu-score; }
                    Readout { text: root.mem-score; }
                    Readout { text: root.disk-score; }
                }

                Hairline { }

                CrtScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        width: 100%;
                        spacing: 0px;

                        SectionLabel {
                            label: "RÉSULTATS DÉTAILLÉS";
                        }

                        Rectangle { height: 8px; }

                        for score[i] in root.scores: Rectangle {
                            height: 32px;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: score.name;
                                    color: Palette.dim;
                                    font-size: 13px;
                                    horizontal-stretch: 2;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: score.value;
                                    color: Palette.crt;
                                    font-size: 13px;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            Hairline {
                                y: parent.height - 1px;
                            }
                        }

                        Rectangle { height: 16px; }

                        SectionLabel {
                            label: "INFORMATIONS SYSTÈME";
                        }

                        Rectangle { height: 8px; }

                        Rectangle {
                            background: Palette.bg;
                            border-width: 1px;
                            border-color: Palette.line;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                for line in root.system-info: Text {
                                    text: "> " + line.text;
                                    color: Palette.dim;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle { height: 8px; }
                    }
                }

                Hairline { }

                HorizontalLayout {
                    spacing: 10px;
                    CrtButton {
                        text: "EXPORTER JSON";
                        clicked => { root.export-clicked(); }
                    }
                    CrtButton {
                        text: "NOUVELLE ANALYSE";
                        clicked => { root.restart-clicked(); }
                    }
                }
            }

            // ERROR
            if root.status == "error": VerticalLayout {
                alignment: center;
                spacing: 14px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(parent.width * 0.8, 520px);
                        background: Palette.bg;
                        border-width: 1px;
                        border-color: Palette.crt;
                        drop-shadow-color: Palette.halo;
                        drop-shadow-blur: 6px;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 8px;
                                StatusLED { active: true; }
                                Text {
                                    text: "!! ERREUR SYSTÈME";
                                    font-size: 12px;
                                    font-weight: 700;
                                    letter-spacing: 3px;
                                    color: Palette.crt;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: root.error-message;
                                color: Palette.dim;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
