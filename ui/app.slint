import "fonts/HelpMe.ttf";
// Brand font R_M_X. Family name embedded in the file: "Help Me"
// (with a space) — that exact name must be used in font-family below.

import { ScrollView, CheckBox } from "std-widgets.slint";

export struct ScoreRow {
    name: string,
    value: string,
}

export struct InfoLine {
    text: string,
}

export struct BenchToggle {
    name: string,
    checked: bool,
}

// ---------------------------------------------------------------------
// Theme (dark default, light optional) + i18n (fr default, en optional)
// ---------------------------------------------------------------------
global Theme {
    in property <bool> dark: true;
}

global I18n {
    in property <string> locale: "fr";

    out property <string> subtitle: "SYSTEM PERFORMANCE ANALYSIS";
    out property <string> ready: locale == "fr" ? "PRÊT" : "READY";
    out property <string> ready-sub: locale == "fr" ? "Le système est prêt pour l'analyse." : "The system is ready for analysis.";
    out property <string> start: locale == "fr" ? "LANCER LE BENCHMARK" : "START BENCHMARK";
    out property <string> running: locale == "fr" ? "ANALYSE EN COURS" : "ANALYSIS IN PROGRESS";
    out property <string> results: locale == "fr" ? "RÉSULTATS DÉTAILLÉS" : "DETAILED RESULTS";
    out property <string> sysinfo: locale == "fr" ? "INFORMATIONS SYSTÈME" : "SYSTEM INFORMATION";
    out property <string> errors: locale == "fr" ? "ERREURS" : "ERRORS";
    out property <string> export-json: locale == "fr" ? "EXPORTER JSON" : "EXPORT JSON";
    out property <string> export-html: locale == "fr" ? "EXPORTER HTML" : "EXPORT HTML";
    out property <string> new-analysis: locale == "fr" ? "NOUVELLE ANALYSE" : "NEW ANALYSIS";
    out property <string> error-title: locale == "fr" ? "ERREUR SYSTÈME" : "SYSTEM ERROR";
    out property <string> select-benches: locale == "fr" ? "BENCHMARKS À EXÉCUTER" : "BENCHMARKS TO RUN";
    out property <string> select-all: locale == "fr" ? "TOUT" : "ALL";
    out property <string> select-none: locale == "fr" ? "AUCUN" : "NONE";
    out property <string> lang-btn: locale == "fr" ? "EN" : "FR";
    out property <string> theme-btn: Theme.dark ? "CLAIR" : "SOMBRE";
    out property <string> status-idle: locale == "fr" ? "INACTIF" : "IDLE";
    out property <string> status-running: locale == "fr" ? "EN COURS" : "RUNNING";
    out property <string> status-showing: locale == "fr" ? "TERMINÉ" : "DONE";
    out property <string> status-error: locale == "fr" ? "ERREUR" : "ERROR";
}

// ---------------------------------------------------------------------
// Design tokens — R_M_X v2.0 chart (Dark Streetwear / Horror Punk / Cyberpunk)
// ---------------------------------------------------------------------
global Palette {
    out property <color> bg-void: Theme.dark ? #050505 : #f5f2ea;         // Noir Absolu / Blanc Cassé
    out property <color> bg-panel: Theme.dark ? #111111 : #ffffff;         // Noir Charbon / blanc pur
    out property <color> bg-panel-hover: Theme.dark ? #1c1c1c : #e8e4d8;
    out property <color> border-idle: Theme.dark ? #232323 : #d8d4c8;
    out property <color> border-strong: Theme.dark ? #3a3a3a : #b8b4a8;
    out property <color> text-dim: Theme.dark ? #6e6b64 : #8a867a;
    out property <color> text-mid: Theme.dark ? #b3afa4 : #5a574e;
    out property <color> text-bright: Theme.dark ? #f5f2ea : #141414;

    out property <color> cyan: #7af9ff;             // Cyan Glacial — accent / hover glow
    out property <color> cyan-dim: #3f8a8f;
    out property <color> rose: #ff7a92;             // Rose Néon — secondary accent
    out property <color> rose-dim: #8a4451;
    out property <color> rouge: #b8323b;            // Rouge Enfer — alert / danger
    out property <color> rouge-dim: #5e1a1f;
    out property <color> cyan-on-light: Theme.dark ? #7af9ff : #0e7c86;

    out property <length> radius: 2px;
}

// ---------------------------------------------------------------------
// Primitives
// ---------------------------------------------------------------------
component HairlineDivider inherits Rectangle {
    height: 1px;
    background: Palette.border-idle;
}

component StatusDot inherits Rectangle {
    in property <color> tone: Palette.text-dim;
    in property <bool> pulsing: false;

    width: 7px;
    height: 7px;
    background: root.tone;
    border-width: 1px;
    border-color: root.tone.darker(0.2);

    property <bool> pulse-phase: false;
    drop-shadow-color: root.pulsing ? Palette.cyan.with-alpha(root.pulse-phase ? 0.75 : 0.15) : transparent;
    drop-shadow-blur: root.pulsing ? (root.pulse-phase ? 9px : 3px) : 0px;
    animate drop-shadow-color, drop-shadow-blur { duration: 900ms; easing: ease-in-out; }

    Timer {
        interval: 900ms;
        running: root.pulsing;
        triggered => { root.pulse-phase = !root.pulse-phase; }
    }
}

component NoirButton inherits Rectangle {
    in property <string> text;
    in property <color> tone: Palette.cyan;
    callback clicked <=> touch.clicked;

    height: 42px;
    border-radius: Palette.radius;
    background: touch.pressed ? Palette.bg-void : (touch.has-hover ? Palette.bg-panel-hover : Palette.bg-panel);
    border-width: 1px;
    border-color: touch.has-hover ? root.tone : Palette.border-idle;
    // Chart v2 spec: cyan glow on hover regardless of the button semantic color.
    drop-shadow-color: touch.has-hover ? Palette.cyan.with-alpha(0.35) : transparent;
    drop-shadow-blur: touch.has-hover ? 12px : 0px;

    animate background, border-color, drop-shadow-color { duration: 200ms; easing: ease; }

    HorizontalLayout {
        alignment: center;
        Text {
            text: root.text;
            color: touch.has-hover ? root.tone : Palette.text-bright;
            font-family: "Help Me";
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 2px;
            vertical-alignment: center;
            animate color { duration: 200ms; }
        }
    }

    touch := TouchArea { }
}

component ProgressRail inherits Rectangle {
    in property <float> progress: 0.0;
    height: 5px;
    border-radius: Palette.radius;
    background: Palette.bg-panel;
    border-width: 1px;
    border-color: Palette.border-idle;
    clip: true;

    Rectangle {
        x: 1px;
        y: 1px;
        height: parent.height - 2px;
        width: max(0px, (parent.width - 2px) * root.progress);
        background: Palette.cyan;
        drop-shadow-color: Palette.cyan.with-alpha(0.5);
        drop-shadow-blur: 6px;
        animate width { duration: 120ms; easing: ease; }
    }
}

component Readout inherits Rectangle {
    in property <string> text;
    in property <color> tone: Palette.cyan;

    background: Palette.bg-panel;
    border-width: 1px;
    border-color: Palette.border-idle;
    border-radius: Palette.radius;
    horizontal-stretch: 1;
    clip: true;

    HorizontalLayout {
        Rectangle {
            width: 3px;
            background: root.tone;
        }
        VerticalLayout {
            padding: 14px;
            alignment: center;
            Text {
                text: root.text;
                color: Palette.text-bright;
                font-family: "Help Me";
                font-size: 14px;
                font-weight: 600;
                wrap: word-wrap;
            }
        }
    }
}

component SectionLabel inherits Text {
    font-family: "Help Me";
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    color: Palette.text-mid;
}

// ---------------------------------------------------------------------
// Main window
// ---------------------------------------------------------------------
export component MainWindow inherits Window {
    title: "OBENCHMARK";
    preferred-width: 1040px;
    preferred-height: 800px;
    background: Palette.bg-void;
    default-font-family: "Help Me";

    in-out property <string> status: "idle";
    in-out property <string> current-test: "";
    in-out property <float> progress: 0.0;
    in-out property <string> error-message: "";
    in-out property <string> last-result: "";

    in-out property <string> final-score: "";
    in-out property <string> cpu-score: "";
    in-out property <string> mem-score: "";
    in-out property <string> disk-score: "";

    in-out property <[ScoreRow]> scores: [];
    in-out property <[InfoLine]> system-info: [];
    in-out property <[string]> error-lines: [];
    in-out property <[BenchToggle]> bench-list: [];
    in-out property <string> export-path: "";

    in-out property <string> locale <=> I18n.locale;
    in-out property <bool> dark <=> Theme.dark;

    callback start-clicked();
    callback export-clicked();
    callback export-html-clicked();
    callback restart-clicked();
    callback bench-toggled(string, bool);
    callback select-all-clicked();
    callback select-none-clicked();
    callback toggle-locale();
    callback toggle-theme();

    property <color> status-tone:
        root.status == "error" ? Palette.rouge :
        root.status == "running" ? Palette.cyan :
        root.status == "showing" ? Palette.cyan : Palette.text-dim;

    property <string> status-text:
        root.status == "idle" ? I18n.status-idle :
        root.status == "running" ? I18n.status-running :
        root.status == "showing" ? I18n.status-showing : I18n.status-error;

    // Base fill
    Rectangle { background: Palette.bg-void; }

    // Grain texture overlay
    Image {
        source: @image-url("../grain.png");
        width: 100%;
        height: 100%;
        image-fit: cover;
        opacity: Theme.dark ? 0.08 : 0.04;
    }

    // Faint watermark logo
    Image {
        source: @image-url("../icon.png");
        opacity: 0.035;
        image-fit: contain;
        width: min(parent.width * 0.5, 380px);
        height: min(parent.height * 0.5, 380px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    VerticalLayout {
        padding: 28px;
        spacing: 18px;

        // ---- Header ----
        HorizontalLayout {
            spacing: 14px;

            VerticalLayout {
                alignment: center;
                Text {
                    text: "OBENCHMARK";
                    font-family: "Help Me";
                    font-size: 20px;
                    font-weight: 700;
                    letter-spacing: 4px;
                    color: Palette.text-bright;
                }
                Text {
                    text: I18n.subtitle;
                    font-family: "Help Me";
                    font-size: 10px;
                    letter-spacing: 2px;
                    color: Palette.text-mid;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                NoirButton {
                    width: 64px;
                    text: I18n.lang-btn;
                    tone: Palette.rose;
                    clicked => { root.toggle-locale(); }
                }
                NoirButton {
                    width: 84px;
                    text: I18n.theme-btn;
                    tone: Palette.rose;
                    clicked => { root.toggle-theme(); }
                }

                StatusDot { tone: root.status-tone; pulsing: root.status == "running"; }
                Text {
                    text: root.status-text;
                    font-family: "Help Me";
                    font-size: 11px;
                    letter-spacing: 2px;
                    color: root.status-tone;
                    vertical-alignment: center;
                }
            }
        }

        HairlineDivider { }

        // ---- Body ----
        Rectangle {
            vertical-stretch: 1;

            // IDLE
            if root.status == "idle": VerticalLayout {
                alignment: center;
                spacing: 18px;

                VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text {
                        text: I18n.ready;
                        horizontal-alignment: center;
                        font-family: "Help Me";
                        font-size: 13px;
                        letter-spacing: 3px;
                        color: Palette.text-mid;
                    }
                    Text {
                        text: I18n.ready-sub;
                        horizontal-alignment: center;
                        font-family: "Help Me";
                        font-size: 13px;
                        color: Palette.text-mid;
                    }
                }

                // Benchmark selection
                VerticalLayout {
                    spacing: 8px;

                    SectionLabel {
                        text: I18n.select-benches;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;
                        NoirButton {
                            width: 90px;
                            text: I18n.select-all;
                            tone: Palette.cyan;
                            clicked => { root.select-all-clicked(); }
                        }
                        NoirButton {
                            width: 90px;
                            text: I18n.select-none;
                            tone: Palette.rose;
                            clicked => { root.select-none-clicked(); }
                        }
                    }

                    Rectangle {
                        width: min(parent.width, 640px);
                        height: 190px;
                        background: Palette.bg-panel;
                        border-width: 1px;
                        border-color: Palette.border-idle;
                        border-radius: Palette.radius;
                        clip: true;

                        ScrollView {
                            VerticalLayout {
                                padding: 10px;
                                GridLayout {
                                    spacing-horizontal: 16px;
                                    spacing-vertical: 2px;
                                    for b in root.bench-list: CheckBox {
                                        text: b.name;
                                        checked: b.checked;
                                        changed checked => { root.bench-toggled(b.name, self.checked); }
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    NoirButton {
                        width: 260px;
                        text: I18n.start;
                        tone: Palette.cyan;
                        clicked => { root.start-clicked(); }
                    }
                }
            }

            // RUNNING
            if root.status == "running": VerticalLayout {
                alignment: center;
                spacing: 18px;

                SectionLabel {
                    text: I18n.running;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.current-test;
                    horizontal-alignment: center;
                    font-family: "Help Me";
                    font-size: 22px;
                    font-weight: 600;
                    color: Palette.text-bright;
                }

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(parent.width, 480px);
                        ProgressRail { progress: root.progress; }
                    }
                }

                Text {
                    text: "\{Math.round(root.progress * 100)}%";
                    horizontal-alignment: center;
                    font-family: "Help Me";
                    font-size: 12px;
                    color: Palette.cyan;
                }

                if root.last-result != "": Text {
                    text: root.last-result;
                    horizontal-alignment: center;
                    font-family: "Help Me";
                    font-size: 11px;
                    color: Palette.text-mid;
                }
            }

            // SHOWING
            if root.status == "showing": VerticalLayout {
                spacing: 16px;

                HorizontalLayout {
                    spacing: 10px;
                    Readout { text: root.final-score; tone: Palette.cyan; }
                    Readout { text: root.cpu-score; tone: Palette.rose-dim; }
                    Readout { text: root.mem-score; tone: Palette.rose-dim; }
                    Readout { text: root.disk-score; tone: Palette.rose-dim; }
                }

                HairlineDivider { }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 0px;

                        if root.error-lines.length > 0: VerticalLayout {
                            spacing: 4px;
                            SectionLabel { text: I18n.errors; }
                            Rectangle {
                                background: Palette.bg-panel;
                                border-width: 1px;
                                border-color: Palette.rouge-dim;
                                border-radius: Palette.radius;
                                clip: true;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 2px;
                                    for e in root.error-lines: Text {
                                        text: "! " + e;
                                        color: Palette.rose;
                                        font-family: "Help Me";
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            Rectangle { height: 8px; }
                        }

                        SectionLabel {
                            text: I18n.results;
                        }

                        Rectangle { height: 8px; }

                        for score[i] in root.scores: Rectangle {
                            height: 34px;
                            background: Palette.bg-void;

                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: score.name;
                                    color: Palette.text-mid;
                                    font-family: "Help Me";
                                    font-size: 13px;
                                    horizontal-stretch: 2;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: score.value;
                                    color: Palette.cyan;
                                    font-family: "Help Me";
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            HairlineDivider {
                                y: parent.height - 1px;
                            }
                        }

                        Rectangle { height: 16px; }

                        SectionLabel {
                            text: I18n.sysinfo;
                        }

                        Rectangle { height: 8px; }

                        Rectangle {
                            background: Palette.bg-panel;
                            border-width: 1px;
                            border-color: Palette.border-idle;
                            border-radius: Palette.radius;
                            clip: true;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;

                                for line in root.system-info: Text {
                                    text: "> " + line.text;
                                    color: Palette.text-mid;
                                    font-family: "Help Me";
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Rectangle { height: 8px; }
                    }
                }

                HairlineDivider { }

                if root.export-path != "": Text {
                    text: root.export-path;
                    horizontal-alignment: center;
                    font-family: "Help Me";
                    font-size: 11px;
                    color: Palette.cyan;
                }

                HorizontalLayout {
                    spacing: 10px;
                    NoirButton {
                        text: I18n.export-json;
                        tone: Palette.cyan;
                        clicked => { root.export-clicked(); }
                    }
                    NoirButton {
                        text: I18n.export-html;
                        tone: Palette.cyan;
                        clicked => { root.export-html-clicked(); }
                    }
                    NoirButton {
                        text: I18n.new-analysis;
                        tone: Palette.rouge;
                        clicked => { root.restart-clicked(); }
                    }
                }
            }

            // ERROR
            if root.status == "error": VerticalLayout {
                alignment: center;
                spacing: 14px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(parent.width * 0.8, 520px);
                        background: Palette.bg-panel;
                        border-width: 1px;
                        border-color: Palette.rouge-dim;
                        border-radius: Palette.radius;
                        clip: true;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 8px;
                                StatusDot { tone: Palette.rouge; }
                                Text {
                                    text: I18n.error-title;
                                    font-family: "Help Me";
                                    font-size: 12px;
                                    letter-spacing: 3px;
                                    color: Palette.rouge;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: root.error-message;
                                color: Palette.text-mid;
                                font-family: "Help Me";
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
